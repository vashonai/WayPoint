# Copy to .env (git-ignored) and fill in.
#
# These keys ship inside the app binary — anyone can extract them. Restrict
# them in Google Cloud → APIs & Services → Credentials, or anyone can bill
# your account:
#   API restrictions  — Maps SDK for Android, Maps SDK for iOS, Routes API,
#                       Places API (New). Nothing else.
#   App restrictions  — Android key: package com.waypoint.app + SHA-1
#                       (expo.dev → project → Credentials).
#                       iOS key: bundle id com.waypoint.app.
GMAPS_ANDROID_KEY=
GMAPS_IOS_KEY=
# SHA-1 of the Android signing cert, colon-separated. Needed once the Android
# key is app-restricted, so Routes / Places calls from JS are accepted.
GMAPS_ANDROID_CERT_SHA1=
