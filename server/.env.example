# Copy to server/.env (git-ignored). The values below are for the local Docker
# stack only — never put real credentials in this file.

# ── Postgres ────────────────────────────────────────────────────────────────
# Local: docker compose. Staging/prod: the Neon connection string from the
# Neon console (pooled endpoint, ?sslmode=require), region aws-us-east-1.
DATABASE_URL=postgres://waypoint:waypoint@localhost:5432/waypoint
# A separate database the test suite resets on every run. Never point at Neon.
TEST_DATABASE_URL=postgres://waypoint:waypoint@localhost:5432/waypoint_test

# ── Valkey (live state: driver positions, online status, trip rooms) ───────
VALKEY_URL=redis://localhost:6379/0
TEST_VALKEY_URL=redis://localhost:6379/15

# ── Object storage (Cloudflare R2; RustFS locally) ───────────────────────────
# R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com, region "auto",
# path-style false, keys from an R2 API token scoped to the two buckets.
R2_ENDPOINT=http://localhost:9000
R2_REGION=auto
R2_ACCESS_KEY_ID=waypoint
R2_SECRET_ACCESS_KEY=waypoint-dev-secret
R2_FORCE_PATH_STYLE=true
R2_BUCKET_EVIDENCE=waypoint-evidence
R2_BUCKET_DOCUMENTS=waypoint-documents

# ── Auth (Better Auth) ──────────────────────────────────────────────────────
# At least 32 random bytes: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Comma-separated. The app's scheme from app.json, plus exp:// in development.
AUTH_TRUSTED_ORIGINS=waypoint://

# ── SMS (phone OTP) ─────────────────────────────────────────────────────────
# "console" prints codes to the server log. Real providers plug in behind
# the SmsProvider interface in src/auth/sms.ts.
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=Waypoint

# ── Email (email OTP) ───────────────────────────────────────────────────────
EMAIL_PROVIDER=console
EMAIL_FROM=Waypoint <no-reply@waypoint.example>
